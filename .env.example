# Identidade explícita do ambiente. Nunca inferir apenas pelo hostname.
APP_ENV=development
VITE_APP_ENV=development

# Vínculo obrigatório do projeto Supabase. Os refs abaixo são exemplos fictícios.
VITE_SUPABASE_URL=https://seu-project-ref-aqui.supabase.co
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
EXPECTED_SUPABASE_PROJECT_REF=seu-project-ref-aqui
VITE_EXPECTED_SUPABASE_PROJECT_REF=seu-project-ref-aqui
PRODUCTION_SUPABASE_PROJECT_REF=project-ref-producao
VITE_PRODUCTION_SUPABASE_PROJECT_REF=project-ref-producao
# Defesa adicional opcional, útil para chaves opacas. Nunca versionar o hash real.
SUPABASE_SERVICE_ROLE_KEY_SHA256=

# Origens explícitas. Staging deve usar uma origem diferente da produção.
PUBLIC_APP_URL=http://localhost:3000
PRODUCTION_APP_ORIGIN=https://www.example.com

# Efeitos externos são bloqueados quando a flag correspondente não é exatamente true.
EMAIL_SEND_ENABLED=false
WHATSAPP_SEND_ENABLED=false
PUSH_SEND_ENABLED=false
N8N_CALLS_ENABLED=false
BATCH_DISPATCH_ENABLED=false
GEMINI_ENABLED=false
ANALYTICS_SEND_ENABLED=false
META_DELIVERY_ENABLED=false
CRON_JOBS_ENABLED=false
# Obrigatório e exclusivo quando CRON_JOBS_ENABLED=true.
CRON_SECRET=
BILLING_ENABLED=false
GOOGLE_INTEGRATIONS_ENABLED=false
LIFECYCLE_SEND_ENABLED=false
CLINIC_FEATURE_ENABLED=false

# Dedicated sensitive invitation transport, STAGING ONLY, never VITE_.
# Do not copy production credentials. Keep disabled until explicit smoke approval.
CLINIC_INVITATION_DELIVERY_ENABLED=false
CLINIC_INVITATION_SMTP_HOST=
CLINIC_INVITATION_SMTP_PORT=587
CLINIC_INVITATION_SMTP_USER=
CLINIC_INVITATION_SMTP_PASS=
CLINIC_INVITATION_SMTP_FROM=
# Set true only after verifying open/click tracking and link rewriting OFF
# in the dedicated staging provider. This flag is not itself delivery proof.
CLINIC_INVITATION_SMTP_TRACKING_DISABLED=false

# Espelhos públicos controlam somente clientes web; as guardas server-side continuam obrigatórias.
VITE_ANALYTICS_SEND_ENABLED=false
VITE_BILLING_ENABLED=false
VITE_GOOGLE_INTEGRATIONS_ENABLED=false
VITE_CLINIC_FEATURE_ENABLED=false

# Gemini API Key (Required for audio transcription when explicitly enabled)
GEMINI_API_KEY=

# WhatsApp Cloud API (server-side only)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=v25.0
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Segredo HMAC exclusivo para OTP. Não reutilizar APP_SECRET ou ACCESS_TOKEN.
WHATSAPP_OTP_SECRET=
WHATSAPP_AUTH_TEMPLATE=ativacao_whatsapp_profissional
WHATSAPP_AUTH_TEMPLATE_LANGUAGE=pt_BR
# Local development exception only. Keep false in production.
WHATSAPP_ALLOW_UNSIGNED_WEBHOOKS=false
# Internal n8n router only. Never expose with a VITE_ prefix.
WHATSAPP_N8N_EVENTS_TOKEN=
WHATSAPP_OPT_OUT_WEBHOOK_TOKEN=
WHATSAPP_USER_LOOKUP_TOKEN=
# Consulta administrativa do grupo da Jornada via n8n; somente no servidor.
N8N_JOURNEY_GROUP_CHECK_WEBHOOK_URL=
N8N_JOURNEY_GROUP_CHECK_TOKEN=
# Execução administrativa de lotes da captação; somente no servidor.
EVOLUCAO_CLINICA_BATCH_DISPATCH_WEBHOOK_URL=
EVOLUCAO_CLINICA_BATCH_DISPATCH_TOKEN=
# Fila backend-only da Jornada de 15 Dias; nunca usar VITE_ neste token.
WHATSAPP_JOURNEY_PUBLICATION_TOKEN=
WHATSAPP_JOURNEY_DEFAULT_DESTINATION_KEY=jornada-15-dias-operador-evolucao-clinica
# Approved administrative templates only (server-side; no VITE_ prefix)
WHATSAPP_TEMPLATE_ACCOUNT_ACCESS=ec_acesso_liberado
WHATSAPP_TEMPLATE_SUPPORT_UPDATE=ec_suporte_atualizado
WHATSAPP_TEMPLATE_SUBSCRIPTION_UPDATE=ec_assinatura_atualizada
WHATSAPP_TEMPLATE_PAYMENT_UPDATE=ec_pagamento_atualizado
WHATSAPP_TEMPLATE_SECURITY_NOTICE=ec_seguranca_conta
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR

# Google Picker API Key (Required for selecting Google Docs)
VITE_GOOGLE_PICKER_API_KEY=

# Analytics web. GTM é o carregador principal. O Measurement ID identifica o
# mesmo stream web usado pela Google Tag no GTM e pelo backend; sozinho ele não
# carrega GA4 direto quando VITE_ANALYTICS_DIRECT_GA4=false.
VITE_GTM_ID=
VITE_GA_MEASUREMENT_ID=
VITE_ANALYTICS_DIRECT_GA4=false

# URL opcional fornecida pela Vercel; não é usada para inferir APP_ENV.
VERCEL_PRODUCTION_URL=

# Lifecycle failure alerting (optional; defaults to 3 failures and 60 minutes)
# LIFECYCLE_FAILURE_ALERT_THRESHOLD=3
# LIFECYCLE_FAILURE_ALERT_COOLDOWN_MINUTES=60

# Firebase Configuration (Optional if using firebase-applet-config.json)
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_FIRESTORE_DATABASE_ID=

# Firebase Admin SDK (JSON completo da conta de serviço, em uma única linha)
# FIREBASE_SERVICE_ACCOUNT_JSON=
