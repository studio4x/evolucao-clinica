# Gemini API Key (Required for audio transcription)
GEMINI_API_KEY=

# Supabase backend (Service Role must never use a VITE_ prefix)
VITE_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# WhatsApp Cloud API (server-side only)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=v25.0
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Local development exception only. Keep false in production.
WHATSAPP_ALLOW_UNSIGNED_WEBHOOKS=false
# Internal n8n router only. Never expose with a VITE_ prefix.
WHATSAPP_N8N_EVENTS_TOKEN=
WHATSAPP_OPT_OUT_WEBHOOK_TOKEN=
WHATSAPP_USER_LOOKUP_TOKEN=configure_um_token_forte
# Consulta administrativa do grupo da Jornada via n8n; somente no servidor.
N8N_JOURNEY_GROUP_CHECK_WEBHOOK_URL=https://webhook.studio4x.com.br/webhook/evolucao-clinica/admin/jornada/verificar-membro
N8N_JOURNEY_GROUP_CHECK_TOKEN=
# Fila backend-only da Jornada de 15 Dias; nunca usar VITE_ neste token.
WHATSAPP_JOURNEY_PUBLICATION_TOKEN=
WHATSAPP_JOURNEY_DEFAULT_DESTINATION_KEY=jornada-15-dias-operador-evolucao-clinica
# Approved administrative templates only (server-side; no VITE_ prefix)
WHATSAPP_TEMPLATE_ACCOUNT_ACCESS=ec_acesso_liberado
WHATSAPP_TEMPLATE_SUPPORT_UPDATE=ec_suporte_atualizado
WHATSAPP_TEMPLATE_SUBSCRIPTION_UPDATE=ec_assinatura_atualizada
WHATSAPP_TEMPLATE_PAYMENT_UPDATE=ec_pagamento_atualizado
WHATSAPP_TEMPLATE_SECURITY_NOTICE=ec_seguranca_conta
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR

# Google Picker API Key (Required for selecting Google Docs)
VITE_GOOGLE_PICKER_API_KEY=

# Analytics web. GTM é o carregador principal. O Measurement ID identifica o
# mesmo stream web usado pela Google Tag no GTM e pelo backend; sozinho ele não
# carrega GA4 direto quando VITE_ANALYTICS_DIRECT_GA4=false.
VITE_GTM_ID=
VITE_GA_MEASUREMENT_ID=
VITE_ANALYTICS_DIRECT_GA4=false

# Production URL used by backend-generated links
VERCEL_PRODUCTION_URL=https://www.evolucaoclinica.app.br
PUBLIC_APP_URL=https://www.evolucaoclinica.app.br

# Lifecycle failure alerting (optional; defaults to 3 failures and 60 minutes)
# LIFECYCLE_FAILURE_ALERT_THRESHOLD=3
# LIFECYCLE_FAILURE_ALERT_COOLDOWN_MINUTES=60

# Firebase Configuration (Optional if using firebase-applet-config.json)
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_FIRESTORE_DATABASE_ID=

# Firebase Admin SDK (JSON completo da conta de serviço, em uma única linha)
# FIREBASE_SERVICE_ACCOUNT_JSON=
